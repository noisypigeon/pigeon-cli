{
  "title": "pigeon-cli overview",
  "uid": "pigeon-cli-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": ["pigeon-cli"],
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "query": "prometheus",
        "label": "Metrics",
        "current": { "text": "Prometheus", "value": "prometheus" }
      },
      {
        "name": "loki",
        "type": "datasource",
        "query": "loki",
        "label": "Logs",
        "current": { "text": "Loki", "value": "loki" }
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${prometheus}" },
        "query": "label_values(pigeon_resource_cpu_percent, instance)",
        "label": "Instance",
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Job phases by phase & instance",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum by (phase, instance) (increase(pigeon_job_phase_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{phase}} - {{instance}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "CPU usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "avg by (instance) (pigeon_resource_cpu_percent{instance=~\"$instance\"})",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Memory usage",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "pigeon_resource_mem_bytes{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Disk I/O throughput",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum by (instance) (rate(pigeon_resource_disk_read_bytes_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} read"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum by (instance) (rate(pigeon_resource_disk_written_bytes_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}} write"
        }
      ]
    },
    {
      "id": 6,
      "title": "Upload throughput",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum by (instance) (rate(pigeon_upload_bytes_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "pigeon-cli job logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "${loki}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "{pigeon_job=~\".+\", instance=~\"$instance\"}"
        }
      ]
    }
  ]
}
